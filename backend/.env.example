HOST=127.0.0.1
PORT=8090
LOG_LEVEL=info

# 控制协议 v2
PROTOCOL_VERSION=vob/1
SESSION_DIRECTORY=runtime/sessions
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_CHARS=4000
SESSION_EVENT_LIMIT=2000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300
# 显式上下文窗口，避免 Ollama 默认值在本机分配过大的 KV cache
OLLAMA_NUM_CTX=4096
# 8GB 显存与 IndexTTS 共用时设为 0，让 LLM 走 CPU；不设置则交给 Ollama 自动分配
# OLLAMA_NUM_GPU=0

# TTS：默认 IndexTTS-2.5 sidecar；切 legacy 用 TTS_PROVIDER=gpt_sovits
TTS_PROVIDER=index_tts
INDEX_TTS_BASE_URL=http://127.0.0.1:9882
INDEX_TTS_TIMEOUT_SECONDS=180
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880/
GPT_SOVITS_TIMEOUT_SECONDS=180

# 音色档案：内置档案 + 用户克隆目录（用户优先）
VOICE_PROFILES_PATH=config/voices.json
USER_VOICE_DIRECTORY=runtime/voices
DEFAULT_VOICE_ID=murasame

AUDIO_DIRECTORY=runtime/audio
ASR_MODEL_PATH=../docker/gpt-sovits/models/asr_models/faster-whisper-large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
